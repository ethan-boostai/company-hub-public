# Copy to .env.local for local development. Never commit real values.

# Postgres connection. Local: the dev database. Supabase: Project Settings > Database >
# Connection string > "Transaction pooler" (port 6543).
DATABASE_URL=postgres://postgres@127.0.0.1:54329/cbs_hub

# Signs upload tickets. 32+ random characters, e.g. from: openssl rand -base64 48
APP_SECRET=

# Supabase project (Storage for signatures and thumbnails). Server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Where uploaded documents go: sharepoint (live), local (development only).
FILE_STORAGE=local

# SharePoint goes through the n8n workflow "CBS Hub - Files" (n8n holds the SharePoint connection).
# N8N_FILES_KEY must match the value in the n8n Header Auth credential "CBS Hub Files key"
# (header name X-CBS-Files-Key). Server only.
N8N_FILES_KEY=
# Required for uploads and the ServiceM8 write-back: the n8n webhook address, e.g. https://<n8n host>/webhook
# (no default; calls to n8n fail with a clear log line if it's missing).
N8N_WEBHOOK_BASE=

# Prefix used by the old n8n hub's PIN hashes (only needed while migrating people).
LEGACY_PIN_SALT=
