        "jsCode": "var src=$('Copy List').all(),res=$input.all(),ok=0,fail=[];src.forEach(function(s,i){var r=res[i]&&res[i].json||{};var sc=Number(r.statusCode||0);if(sc===202||sc===200)ok++;else fail.push(s.json.job+' | '+s.json.cat+' | '+s.json.name+' | '+(sc||'no reply')+' '+String(r.body||'').slice(0,120));});return [{json:{requested:src.length,accepted:ok,failed:fail.length,failures:fail.slice(0,100)}}];"
