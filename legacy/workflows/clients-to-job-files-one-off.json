        "jsCode": "var cl=$('Category List').all(),got=$input.all(),map={};cl.forEach(function(c,i){var r=got[i]&&got[i].json;if(r&&r.id)map[c.json.job+'|'+c.json.cat]=r.id;});var out=[],miss=0;$('Plan').all().forEach(function(f){var pid=map[f.json.job+'|'+f.json.cat];if(!pid){miss++;return;}out.push({json:{id:f.json.id,pid:pid,job:f.json.job,cat:f.json.cat,name:'Job '+f.json.job+' - '+f.json.name}});});if(!out.length)return [{json:{none:true,miss:miss}}];return out;"
