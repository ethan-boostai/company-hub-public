      "id": "d6a374c6-6a90-4083-a525-ebc4e3280107",
      "name": "Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "var dry=String(($('Run Hook').first().json.query||{}).dry||'1')!=='0';\nvar hub=$('Hub Jobs').first().json;var refs={};\n(hub.clients||[]).forEach(function(c){(c.jobs||[]).forEach(function(j){var m=String(j.desc||'').match(/^\\s*(\\d{5})\\b/);if(m)refs[m[1]]={no:String(j.no),client:c.name.toLowerCase()};});});\nvar okmap={'zz client a':['zz client a'],'zz client p':['zz client p'],'zz client q':['zz client a - site 2','zz client p - zz client a site 2'],'zz client b':['zz client b'],'zz client c':['zz client c'],'zz client d':['zz client d'],'zz client e':['zz client e2','zz client e'],'zz client f':['zz client f'],'zz client g':['zz client g','zz client g school'],'zz client h':['zz client h'],'zz client i':['zz client i'],'zz client j':['zz client j'],'zz client k':['zz client k'],'zz client l ltd':['zz client l'],'zz client m':['zz client m'],'zz client n':['zz client n'],'zz client o':[],'zz client r':['zz client r']};\nfunction cat(n,e){var u=n.toUpperCase();\n if(/\\bQW\\b|\\bDD\\b|\\bRP\\b|QUOTE|ESTIMATE|PRICING|COSTING/.test(u))return 'Estimate';\n if(/\\bRAMS?\\b|METHOD STATEMENT/.test(u))return 'RAMS';\n if(/\\bP\\.?O\\b|PURCHASE.?ORDER/.test(u))return 'Purchase orders';\n if(/SURVEY|REPORT/.test(u))return 'Site Surveys';\n if(/DRAWING|\\bDWG\\b|LAYOUT|\\bGA\\b|-DR-|SK\\d|ELEVATION/.test(u)||e==='dwg'||e==='dxf')return 'Drawings';\n if(/DATA ?SHEET|\\bSDS\\b|\\bTDS\\b|ALTRO|SIKA|COLORCOAT|SOURCING|BDI /.test(u))return '';\n if(['pdf','xlsx','doc','docx'].indexOf(e)>=0)return 'Estimate';return '';}\nvar files=[],skipped={};function sk(k){skipped[k]=(skipped[k]||0)+1;}\nfor(var r=0;r<300;r++){var arr=null;try{arr=$('List').all(0,r);}catch(e){break;}if(!arr||!arr.length)break;\n arr.forEach(function(it){(it.json.value||[]).forEach(function(x){if(!x.file)return;\n  var m=String(x.name).match(/^(\\d{5})(?:r\\d+)?(?!\\d)/);if(!m||!refs[m[1]])return;var job=refs[m[1]];\n  var p=(x.parentReference&&x.parentReference.path)||'';try{p=decodeURIComponent(p);}catch(e){}p=p.replace(/^\\/drives\\/[^\\/]+\\/root:?\\/?/,'');\n  var top=(p.split('/')[1]||'').toLowerCase();var keys=okmap[top];if(keys&&!keys.some(function(k){return job.client.indexOf(k)>=0;})){sk('client folder mismatch');return;}\n  var em=String(x.name).match(/\\.([a-z0-9]{1,5})$/i);var e=em?em[1].toLowerCase():'';\n  if(e==='pub'||e==='lnk'){sk('pub/lnk');return;}\n  if(String(x.lastModifiedDateTime||'')<'2025-01-01'){sk('pre-2025');return;}\n  var c=cat(x.name,e);if(!c){sk('data sheet / unknown');return;}\n  files.push({json:{id:x.id,name:x.name,job:job.no,cat:c,src:p}});});});}\nvar byCat={},jobs={};files.forEach(function(f){byCat[f.json.cat]=(byCat[f.json.cat]||0)+1;jobs[f.json.job]=1;});\nif(dry)return [{json:{dry:true,files:files.length,jobs:Object.keys(jobs).length,byCat:byCat,skipped:skipped,sample:files.slice(0,15).map(function(f){return f.json.job+' | '+f.json.cat+' | '+f.json.name;})}}];\nreturn files;"
      }
