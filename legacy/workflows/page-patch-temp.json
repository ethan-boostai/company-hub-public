    {
      "id": "31364606-6798-4e70-b0c9-d880419e03c5",
      "name": "Build",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$('Patch Hook').first().json.body||{};\nconst rows=$input.all().map(i=>i.json);\nif(b.list)return [{json:{apply:false,err:'list',names:rows.map(r=>r.name).filter(n=>!/^_bak_/.test(n)&&(!b.list.length||String(n).indexOf(b.list)>-1)).slice(0,200),total:rows.length}}];\nconst page=b.page||'page:cbs-admin';\nconst row=rows.find(r=>r.name===page);\nif(!row)return [{json:{apply:false,err:'no page'}}];\nlet o,h,raw=false;try{o=JSON.parse(row.content);h=o.b;}catch(e){raw=true;h=row.content;}\nif(typeof h!=='string'){raw=true;h=row.content;}\nconst syn=[];(b.checks||[]).forEach((js,i)=>{try{new Function(js);syn.push('ok');}catch(e){syn.push('ERR '+i+': '+e.message);}});\nif(syn.some(s=>s!=='ok'))return [{json:{apply:false,err:'syntax',syn}}];\nconst counts=[];let bad=false;\nfor(const [a,c] of (b.reps||[])){const n=h.split(a).length-1;counts.push(n);if(n!==1){bad=true;continue;}h=h.split(a).join(c);}\nif(bad)return [{json:{apply:false,err:'counts',counts}}];\nif(b.wholeCheck){try{new Function(h);syn.push('whole ok');}catch(e){return [{json:{apply:false,err:'whole script error: '+e.message}}];}}\nconst content=raw?h:JSON.stringify(Object.assign(o,{b:h}));const apply=b.dry===false;\nreturn [{json:{apply,raw,counts,syn,id:row.id,bakName:'_bak_'+(b.tag||'patch')+'_'+page,before:row.content.length,after:content.length,bak:apply?row.content:'',content:apply?content:''}}];"
      }
    },
