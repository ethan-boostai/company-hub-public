    {
      "id": "5403c4f2-30fd-4e3d-b689-666e49a1860e",
      "name": "Plan New Descriptions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "jsCode": "// Only touches jobs created by 'CBS - Excel to ServiceM8' (they carry a\n// 'Source: <tab> sheet, row N' line). Rewrites the first line to\n// '<sheet job number> <description>'. Everything below line 1 is kept.\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  const desc = String(j.job_description || '');\n  if (!/\\nSource: .+ sheet, row \\d+/.test(desc)) { continue; }\n  const jobNumber = String(j.purchase_order_number || '').trim();\n  if (!jobNumber) { continue; }\n  const lines = desc.split('\\n');\n  let first = lines[0];\n  const areaLine = lines.find(function (l) { return l.indexOf('Area: ') === 0; });\n  const area = areaLine ? areaLine.slice(6).trim() : '';\n  if (area && first.indexOf(area + ' - ') === 0) { first = first.slice(area.length + 3); }\n  if (first.indexOf(jobNumber + ' ') === 0) { continue; }\n  const newFirst = jobNumber + ' ' + first.trim();\n  lines[0] = newFirst;\n  out.push({ json: { uuid: j.uuid, smJobNo: j.generated_job_id, oldFirstLine: desc.split('\\n')[0], newFirstLine: newFirst, newDescription: lines.join('\\n') } });\n}\nreturn out;"
      }
    },
    {
      "id": "89524b60-5fdf-4582-b002-1465ef2dde9e",
      "name": "Update Job Description",
      "type": "@servicem8/n8n-nodes-servicem8.serviceM8",
      "typeVersion": 1,
      "position": [
        672,
        0
      ],
      "parameters": {
        "fields": {
