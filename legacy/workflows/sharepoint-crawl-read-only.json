        "jsCode": "var files=[],errs=0,pages=0;for(var r=0;r<200;r++){var arr=null;try{arr=$('List').all(0,r);}catch(e){break;}if(!arr||!arr.length)break;arr.forEach(function(it){pages++;if(it.json.error)errs++;(it.json.value||[]).forEach(function(x){if(!x.file)return;var p=(x.parentReference&&x.parentReference.path)||'';try{p=decodeURIComponent(p);}catch(e){}p=p.replace(/^\\/drives\\/[^/]+\\/root:?\\/?/,'');var m=String(x.name).match(/\\.([a-z0-9]{1,5})$/i);files.push({p:p,n:x.name,e:m?m[1].toLowerCase():'',s:x.size,d:String(x.lastModifiedDateTime||'').slice(0,10),id:x.id});});});}return [{json:{pages:pages,errors:errs,count:files.length,files:files}}];"
