        "jsCode": "var D='b!ZZ-example-drive-id';var out=[];$input.all().forEach(function(it){(it.json.value||[]).forEach(function(x){if(x.folder&&x.folder.childCount>0)out.push({json:{done:false,url:'https://graph.microsoft.com/v1.0/drives/'+D+'/items/'+x.id+'/children?$top=999&$select=id,name,folder,file,size,lastModifiedDateTime,parentReference'}});});});if(!out.length)return [{json:{done:true}}];return out;"
