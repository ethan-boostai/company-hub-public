      {
        "id": "cc0344c1-0fed-43d6-9b0d-2bf4c62dafd8",
        "name": "Create Missing Job Files",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          224,
          0
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "/* Every job in the ServiceM8 Reactive or Maintenance folder (pipeline 'others') or Approved / Part Approved (pipeline 'jobs', kind approved) gets a Job File.\n   Jobs with no Job File in the hub get one created as Project, using the same creator as the Approve button in Enquiry prep (cbs-cdm-set).\n   Existing and closed Job Files are never touched. */\nvar H='https://old-hub.example/webhook/';\nfunction S(v){return v==null?'':String(v).trim();}\nvar pr=await this.helpers.httpRequest({url:H+'cbs-pipeline',json:true,timeout:60000});\nif(typeof pr==='string')pr=JSON.parse(pr);\nif(!pr||!pr.ok)throw new Error('cbs-pipeline did not load');\nvar rx=(pr.others||[]).filter(function(x){return /reactive|approved|maint/i.test(S(x.folder));}).map(function(x){var f=S(x.folder);return {no:S(x.no),mode:S(x.mode),src:/reactive/i.test(f)?'Reactive':/maint/i.test(f)?'Maintenance':'Approved'};});\nvar ap=(pr.jobs||[]).filter(function(x){return S(x.kind)==='approved';}).map(function(x){return {no:S(x.no),mode:S(x.mode),src:'Approved'};});\nvar seen={},all=[];rx.concat(ap).forEach(function(x){if(x.no&&!seen[x.no]){seen[x.no]=1;all.push(x);}});\nvar todo=all.filter(function(x){return !x.mode;});\nvar made=[],failed=[];\nfor(var i=0;i<todo.length;i++){var no=todo[i].no;\n try{var r=await this.helpers.httpRequest({method:'POST',url:H+'cbs-cdm-set',body:{job_no:no,mode:'project',create:true,by:'Auto: '+todo[i].src+' folder'},json:true,timeout:30000});\n  if(r&&(r.error||r.ok===false))failed.push(no+': '+S(r.error||'not created'));else made.push(no);}\n catch(e){failed.push(no+': '+S(e.message));}}\nreturn [{json:{reactive:rx.length,approved:ap.length,alreadyHadJobFile:all.length-todo.length,created:made,failed:failed}}];"
        }
      },
      {
