    {
      "id": "63ad9475-e03d-4d65-8858-84d7f0af8ab8",
      "name": "Hook Prep",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        900
      ],
      "parameters": {
        "jsCode": "/* Hook Prep: one item per ServiceM8 webhook (job.created / updated / queued / status_changed / completed, company.created / updated).\n   Keeps the event type and, for job events, the job record from the payload. */\nreturn $input.all().map(function(i){var p=i.json||{};var ev=String(p.type||p.triggerEvent||'');var d=p.data||{};\n return {json:{ev:ev,isJob:/^job\\./.test(ev),job:/^job\\./.test(ev)?d:null,company:/^company\\./.test(ev)?(d.name||''):''}};});",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "9ec4a852-30ea-4b95-a114-2ffb28b8e796",
      "name": "SM8 Queues (hook)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        900
      ],
      "parameters": {
        "authentication": "predefinedCredentialType",
        "method": "GET",
        "nodeCredentialType": "serviceM8CredentialsApi",
        "options": {
          "timeout": 30000
        },
        "url": "https://api.servicem8.com/api_1.0/queue.json"
      },
