      {
        "id": "712d25d5-0acb-4d8f-9924-92be34541a16",
        "name": "Folder Keeper",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          672,
          220
        ],
        "parameters": {
          "jsCode": "/* Folder keeper (every 5 minutes). ServiceM8 drops a job out of its folder when the folder's expiry date passes.\n   For active Work Order jobs in Approved, Part Approved, Reactive or Maintenance:\n   - expiry less than 60 days away: pushed out to a year from now, so the job stays in its folder;\n   - job left with no folder but it was in one of those folders last time: put back into that folder (for a year).\n   Completed, estimate and other-folder jobs are never touched. Remembers each job's folder in this workflow's static data.\n   Output: one item per job to update (SM8 Set Folder), at most 40 per run. */\nvar KEEP=/^(approved|part approved)$|reactive|maint/i;\nvar Q={};$('SM8 Queues').all().forEach(function(i){var q=i.json;if(q&&q.uuid)Q[q.uuid]=String(q.name||'').trim();});\nvar J=$input.all().map(function(i){return i.json;}).filter(function(j){return j&&j.uuid&&String(j.active)==='1'&&j.status==='Work Order';});\nvar st=$getWorkflowStaticData('global');var prev=st.folders||{};var next={};\nfunction pad(n){return('0'+n).slice(-2);}\nfunction fmt(d){return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())+' '+pad(d.getHours())+':'+pad(d.getMinutes())+':'+pad(d.getSeconds());}\nvar now=Date.now(),YEAR=fmt(new Date(now+365*864e5)),SOON=now+60*864e5,out=[],kept=0,restored=[],extended=[];\nJ.forEach(function(j){var q=String(j.queue_uuid||''),name=Q[q]||'';\n if(q&&KEEP.test(name)){next[j.uuid]=q;var ex=Date.parse(String(j.queue_expiry_date||'').replace(' ','T'));\n  if(!(ex>SOON)){out.push({uuid:j.uuid,queue_uuid:q,queue_expiry_date:YEAR,job:j.generated_job_id,folder:name,why:'extend'});extended.push(j.generated_job_id);}else kept++;}\n else if(!q&&prev[j.uuid]&&KEEP.test(Q[prev[j.uuid]]||'')){next[j.uuid]=prev[j.uuid];out.push({uuid:j.uuid,queue_uuid:prev[j.uuid],queue_expiry_date:YEAR,job:j.generated_job_id,folder:Q[prev[j.uuid]],why:'restore'});restored.push(j.generated_job_id+' -> '+Q[prev[j.uuid]]);}\n});\nst.folders=next;st.last={at:new Date().toISOString(),jobs:J.length,kept:kept,extended:extended,restored:restored};\nout=out.slice(0,40);\nif(!out.length)return [];\nreturn out.map(function(o){return {json:o};});\n",
          "mode": "runOnceForAllItems"
        }
      },
