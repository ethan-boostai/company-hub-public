      {
        "id": "cc282a3a-59d3-4bf8-8650-8af5cddb49ee",
        "name": "Job File Check",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1580,
          900
        ],
        "parameters": {
          "jsCode": "/* Job File Check: after the fresh Jobs list, a job in Approved / Part Approved / Reactive / Maintenance with no Job File\n   gets one created as Project (same as the 5-minute poll; existing, CDM and closed Job Files are never touched). */\nvar D=$('Hook Decide').first().json;if(!D.jf||!D.job)return [];\nfunction S(v){return v==null?'':String(v).trim();}\nvar pr=$input.first().json;if(typeof pr==='string'){try{pr=JSON.parse(pr);}catch(e){pr={};}}if(!pr||!pr.ok)return [];\nvar hit=null;\n(pr.jobs||[]).forEach(function(x){if(S(x.no)===D.job&&S(x.kind)==='approved')hit={mode:S(x.mode),src:'Approved'};});\n(pr.others||[]).forEach(function(x){var f=S(x.folder);if(S(x.no)===D.job&&/reactive|approved|maint/i.test(f))hit={mode:S(x.mode),src:/reactive/i.test(f)?'Reactive':/maint/i.test(f)?'Maintenance':'Approved'};});\nif(!hit||hit.mode)return [];\nreturn [{json:{job_no:D.job,mode:'project',create:true,by:'Auto: '+hit.src+' folder'}}];",
          "mode": "runOnceForAllItems"
        }
      },
