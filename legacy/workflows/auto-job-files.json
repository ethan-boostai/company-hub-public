      {
        "id": "4cc43fb8-a7b7-4b34-8a7c-91235b366ef6",
        "name": "Hook Decide",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          700,
          900
        ],
        "parameters": {
          "jsCode": "/* Hook Decide (instant version of the 5-minute Folder Keeper + Job File creator).\n   restore: a Work Order that was in Approved / Part Approved / Reactive / Maintenance and now has no folder (ServiceM8 drops it\n            when it is scheduled) goes straight back into that folder for a year. Uses the same static folder map as Folder Keeper.\n   jf:      a job placed in one of those folders (job.queued only, so one change does not create twice) gets checked for a Job File after the Jobs list refresh.\n   Quote jobs are never filed - the team picks their folder. */\nvar KEEP=/^(approved|part approved)$|reactive|maint/i;\nvar Q={};$('SM8 Queues (hook)').all().forEach(function(i){var q=i.json;if(q&&q.uuid)Q[q.uuid]=String(q.name||'').trim();});\nvar p=$('Hook Prep').first().json,j=p.job||{};\nvar st=$getWorkflowStaticData('global');st.folders=st.folders||{};\nfunction pad(n){return('0'+n).slice(-2);}\nvar d=new Date(Date.now()+365*864e5),YEAR=d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())+' '+pad(d.getHours())+':'+pad(d.getMinutes())+':'+pad(d.getSeconds());\nvar out={ev:p.ev,job:String(j.generated_job_id||''),restore:null,jf:false};\nif(p.isJob&&j.uuid&&String(j.active)==='1'){var q=String(j.queue_uuid||''),name=Q[q]||'';\n if(q&&KEEP.test(name)){if(j.status==='Work Order')st.folders[j.uuid]=q;if(p.ev==='job.queued')out.jf=true;}\n else if(!q&&j.status==='Work Order'&&st.folders[j.uuid]&&KEEP.test(Q[st.folders[j.uuid]]||'')){\n  out.restore={uuid:j.uuid,queue_uuid:st.folders[j.uuid],queue_expiry_date:YEAR,folder:Q[st.folders[j.uuid]]};out.jf=true;}}\nst.hookLast={at:new Date().toISOString(),ev:out.ev,job:out.job,restored:out.restore?out.restore.folder:'',jf:out.jf};\nreturn [{json:out}];",
          "mode": "runOnceForAllItems"
        }
      },
