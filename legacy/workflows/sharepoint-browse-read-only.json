        "jsCode": "var j=$input.first().json;var q=j.query||{};var b=j.body||{};var path=String(q.path||b.path||'').trim().replace(/^\\/+|\\/+$/g,'');var s=String(q.q||b.q||'').trim();var D='b!ZZ-example-drive-id';var sel='$select=name,folder,file,size,lastModifiedDateTime,webUrl,parentReference&$top=999';var url;if(s){url='https://graph.microsoft.com/v1.0/drives/'+D+\"/root/search(q='\"+encodeURIComponent(s.replace(/'/g,\"''\"))+\"')?\"+sel;}else if(path){url='https://graph.microsoft.com/v1.0/drives/'+D+'/root:/'+path.split('/').map(encodeURIComponent).join('/')+':/children?'+sel;}else{url='https://graph.microsoft.com/v1.0/drives/'+D+'/root/children?'+sel;}return [{json:{url:url,path:path,q:s}}];"
