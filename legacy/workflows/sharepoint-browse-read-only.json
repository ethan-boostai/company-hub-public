        "jsCode": "var r=$input.first().json;var p=$('Plan').first().json;if(r.error)return [{json:{ok:false,path:p.path,q:p.q,error:r.error}}];var items=(r.value||[]).map(function(x){var pp=(x.parentReference&&x.parentReference.path)||'';try{pp=decodeURIComponent(pp).replace(/^\\/drives\\/[^/]+\\/root:?/,'');}catch(e){}return {name:x.name,type:x.folder?'folder':'file',children:x.folder?x.folder.childCount:undefined,size:x.size,modified:x.lastModifiedDateTime,parent:pp,url:x.webUrl};});return [{json:{ok:true,path:p.path,q:p.q,count:items.length,items:items}}];"
