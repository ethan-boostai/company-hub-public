    {
      "id": "31c18e23-1eb5-48d2-bb68-d27a24f58257",
      "name": "Find Terms",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        150
      ],
      "parameters": {
        "jsCode": "/* read-only: snippets around terms in stored pages. body: {page, terms:[], ctx, max} */\nconst rows=$input.all().map(i=>i.json);const q=($('Inspect Hook').first().json.body)||{};\nconst pg=q.page||'page:cbs-admin';const row=rows.filter(r=>r.name===pg)[0];if(!row)return [{json:{error:'no page '+pg,names:rows.map(r=>r.name).filter(n=>!/^_bak/.test(n))}}];\nlet b=String(row.content);try{const o=JSON.parse(row.content);b=String(o.b||row.content);}catch(e){}\nconst ctx=q.ctx||220,max=q.max||12;const out={page:pg,len:b.length,hits:{}};\n(q.terms||[]).forEach(t=>{const arr=[];let i=-1;let c=0;while((i=b.indexOf(t,i+1))>=0){c++;if(arr.length<max)arr.push(i+': '+b.slice(Math.max(0,i-ctx),i+t.length+ctx));}out.hits[t]={count:c,snips:arr};});\nreturn [{json:out}];",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "607276f1-3b10-4a53-a06e-034240903a8a",
      "name": "Strip Scaff",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        700
      ],
      "parameters": {
        "jsCode": "/* Patch cbsKeep: only restore the last hub section on reload / browser back-forward, never on a fresh visit. Runs only when body.patch==='keepnav'. Any problem throws (nothing saved). */\nconst q=($('Inspect Hook').first().json.body)||{};if(q.patch!=='keepnav')return [];\nconst row=$input.all().map(i=>i.json).filter(r=>r.name==='page:cbs-admin')[0];\nif(!row)throw new Error('page:cbs-admin not found');\nconst o=JSON.parse(row.content);const b=String(o.b);\nconst A='if(!deep){try{var hs=history.state;';const Z='saved={cbs:ss.cbs,d:0};}catch(e){}}}';\nif(b.split(A).length-1!==1)throw new Error('start found '+(b.split(A).length-1)+'x');\nconst s=b.indexOf(A),e=b.indexOf(Z,s);if(e<0||e-s>400)throw new Error('end not found near start');\nconst NEW='var nt=\"\";try{var ne=performance.getEntriesByType(\"navigation\")[0];if(ne)nt=ne.type;}catch(e){}\\n'+\n'if(!nt){try{var pn=performance.navigation.type;nt=pn===1?\"reload\":pn===2?\"back_forward\":\"navigate\";}catch(e){}}\\n'+\n'if(nt===\"navigate\"){try{sessionStorage.removeItem(K);}catch(e){}}\\n'+\n'if(!deep&&nt!==\"navigate\"){try{var hs=history.state;if(hs&&hs.cbs)saved={cbs:hs.cbs,d:hs.d||0};}catch(e){}\\n'+\n' if(!saved&&nt===\"reload\"){try{var ss=JSON.parse(sessionStorage.getItem(K)||\"null\");if(ss&&ss.cbs)saved={cbs:ss.cbs,d:0};}catch(e){}}}';\nconst nb=b.slice(0,s)+NEW+b.slice(e+Z.length);\nconst ks=nb.indexOf('<script id=\"cbsKeep\">');const ke=nb.indexOf('</script>',ks);\nnew Function(nb.slice(ks+21,ke));\nif(nb.length<b.length)throw new Error('new page shorter than old - aborting');\no.b=nb;\nreturn [{json:{id:row.id,original:row.content,content:JSON.stringify(o),oldBlock:b.slice(s,e+Z.length),newBlock:NEW,ok:true}}];",
        "mode": "runOnceForAllItems"
      }
    },
