      "id": "df438fed-32dc-4b87-aa9c-7c36c2086fdb",
      "name": "Bake",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        500
      ],
      "parameters": {
        "jsCode": "const OLD='<style id=\"cbsHdrM\">@media (max-width:640px){header{flex-wrap:wrap;row-gap:8px}header h1{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}#enqBtn,#tvBtn{flex:1 1 40%;margin:0!important;text-align:center}}</style>';\nconst CSS='@media (max-width:760px){'+\n'header{flex-wrap:wrap!important;row-gap:10px!important;column-gap:10px!important;padding:10px 12px!important}'+\n'#menuBtn{order:1}#cbsLogo{order:2}header h1#title{order:3;flex:1 1 0!important;min-width:0;margin:0!important;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:16px!important}#bellBtn{order:4}'+\n'header::after{content:\"\";order:5;flex-basis:100%;height:0}'+\n'#back{order:6;flex:0 0 auto;margin:0!important;padding:7px 10px!important;border:1px solid #6b6e70!important;border-radius:8px!important;white-space:nowrap}'+\n'#enqBtn{order:7}#tvBtn{order:8}'+\n'#enqBtn,#tvBtn{flex:1 1 0!important;margin:0!important;text-align:center;padding:8px 10px!important}'+\n'#qm,#nt{top:var(--cbsHdH,57px)!important}}';\nconst JS='(function(){var hd=document.querySelector(\"header\");if(!hd)return;function s(){try{document.documentElement.style.setProperty(\"--cbsHdH\",hd.getBoundingClientRect().height+\"px\");}catch(e){}}s();if(window.ResizeObserver){new ResizeObserver(s).observe(hd);}else{window.addEventListener(\"resize\",s);setInterval(s,1500);}})();';\ntry{new Function(JS);}catch(e){return [{json:{error:'syntax '+e.message}}];}\nconst NEW='<style id=\"cbsHdrM\">'+CSS+'</style><script id=\"cbsHdrMjs\">'+JS+'</script>';\nconst row=$input.all().map(i=>i.json).filter(r=>r.name==='page:cbs-admin')[0];\nconst o=JSON.parse(row.content);const n=o.b.split(OLD).length-1;if(n!==1)return [{json:{error:'old style found '+n+'x'}}];\no.b=o.b.split(OLD).join(NEW);return [{json:{id:row.id,content:JSON.stringify(o),ok:true}}];"
      }
