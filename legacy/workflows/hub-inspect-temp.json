    {
      "id": "5b8cb747-2c49-492b-b32d-c731998d2378",
      "name": "Summarise SM8",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        400
      ],
      "parameters": {
        "jsCode": "const Q=$('SM8 Co').all().map(i=>i.json);const J=$input.all().map(i=>i.json);const qn={};Q.forEach(q=>qn[q.uuid]=String(q.name).trim());\nconst ex={};J.forEach(j=>{const k=(qn[j.queue_uuid]||'(no folder)')+' expires '+String(j.queue_expiry_date||'').slice(0,7);ex[k]=(ex[k]||0)+1;});\nreturn [{json:{workOrders:J.length,byFolderAndExpiry:ex}}];",
        "mode": "runOnceForAllItems"
      }
    }
