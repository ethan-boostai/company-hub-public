        "jsCode": "const P=$('Plan').all().map(i=>i.json).filter(x=>x&&x.ok);const a=P.length?P[0].a:'';\nconst w={back:'back in the yard',extend:'due-back date changed',move:'moved'}[a]||'saved';\nreturn [{json:{ok:true,n:P.length,message:P.length+(P.length===1?' item ':' items ')+w+'.'}}];"
