    {
      "id": "f762471f-6762-496b-be5a-0601f2e81952",
      "name": "Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "/* PLANT RETURN (keep, Ethan 28/10): actions for the 'Plant overdue back' card. Body {a, ids:[asset ids], due:'YYYY-MM-DD', job, van, by}.\n   back   = back in the yard: out_job/out_with/out_since/due_back cleared, yard_status In, location CBS Warehouse.\n   extend = new due_back only.\n   move   = to a job (out_job, location 'Job N') or to a van (out_with + location = van, no job); new due_back; out_since today; yard_status Out.\n   Nothing is written unless every id exists and the action's fields are valid. */\nconst S=v=>v==null?'':String(v).trim();\nconst b=($('Plant Act Hook').first().json.body)||{};const a=S(b.a);const ids=(Array.isArray(b.ids)?b.ids:[b.ids]).map(x=>Number(x)).filter(x=>x>0);\nconst err=m=>[{json:{ok:false,message:m}}];\nif(!/^(back|extend|move)$/.test(a))return err('Unknown action.');\nif(!ids.length)return err('No items chosen.');\nconst R={};$input.all().forEach(i=>{const r=i.json;if(r&&r.id!=null)R[Number(r.id)]=r;});\nconst miss=ids.filter(i=>!R[i]);if(miss.length)return err('Item not found: '+miss.join(', '));\nconst due=S(b.due).slice(0,10),ISO=/^\\d{4}-\\d\\d-\\d\\d$/;\nconst today=new Date().toLocaleDateString('en-CA',{timeZone:'Europe/London'});\nif((a==='extend'||a==='move')&&!ISO.test(due))return err('Choose a due-back date.');\nconst job=S(b.job).replace(/^#/,''),van=S(b.van);\nif(a==='move'&&!job&&!van)return err('Choose a job or a van.');\nreturn ids.map(id=>{const r=R[id];let f;\n if(a==='back')f={out_job:'',out_with:'',out_since:'',due_back:'',yard_status:'In',location:'CBS Warehouse'};\n else if(a==='extend')f={out_job:S(r.out_job),out_with:S(r.out_with),out_since:S(r.out_since),due_back:due,yard_status:S(r.yard_status)||'Out',location:S(r.location)};\n else if(job)f={out_job:job,out_with:S(r.out_with),out_since:today,due_back:due,yard_status:'Out',location:'Job '+job};\n else f={out_job:'',out_with:van,out_since:today,due_back:due,yard_status:'Out',location:van};\n return {json:Object.assign({ok:true,id,name:S(r.name),a},f)};});"
      }
    },
