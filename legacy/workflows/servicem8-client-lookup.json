      "position": [
        448,
        0
      ],
      "parameters": {
        "jsCode": "// Read-only helper. Lists every ServiceM8 client with its UUID\n// so the map in 'CBS - Excel to ServiceM8 (Create Job)' can be extended.\nconst rows = $input.all().map(function (item) {\n  const c = item.json;\n  return {\n    name: c.name,\n    uuid: c.uuid,\n    address: c.address || ''\n  };\n});\n\nrows.sort(function (a, b) {\n  return String(a.name).localeCompare(String(b.name));\n});\n\nreturn rows.map(function (r) { return { json: r }; });"
      }
    }
