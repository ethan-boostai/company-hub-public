    {
      "id": "81bab52d-9445-49c5-8637-f0073995501c",
      "name": "Build",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$('Patch Hook').first().json.body||{};\nconst rows=$input.all().map(i=>i.json);\nconst page=b.page||'page:cbs-admin';const id=String(b.id||'');\nif(!/^[A-Za-z0-9_-]+$/.test(id))return [{json:{apply:false,err:'bad id'}}];\nconst row=rows.find(r=>r.name===page);\nif(!row)return [{json:{apply:false,err:'no page'}}];\nconst o=JSON.parse(row.content);let h=o.b;\nlet js=String(b.script||'');\nif(!js||js.indexOf('</script')>-1)return [{json:{apply:false,err:'bad script'}}];\nlet syntax='ok';try{new Function(js);}catch(e){syntax='ERR '+e.message;}\nif(syntax!=='ok')return [{json:{apply:false,err:'syntax',syntax}}];\nif(js.indexOf('__LG__')>-1){const m=h.match(/var LG='(data:image\\/png;base64,[^']+)'/)||h.match(/var LG=\"(data:image\\/png;base64,[^\"]+)\"/);if(!m)return [{json:{apply:false,err:'no logo'}}];js=js.split('__LG__').join(m[1]);}\nconst open='<script id=\"'+id+'\">';const n=h.split(open).length-1;\nlet mode='';\nif(n===1){const re=new RegExp('<script id=\"'+id+'\">[\\\\s\\\\S]*?<\\\\/script>');h=h.replace(re,()=>open+js+'</script>');mode='replaced';}\nelse if(n===0&&b.before){const k=h.split(b.before).length-1;if(k!==1)return [{json:{apply:false,err:'anchor count '+k}}];h=h.split(b.before).join(open+js+'</script>'+b.before);mode='inserted';}\nelse return [{json:{apply:false,err:'block count '+n}}];\no.b=h;const apply=b.dry===false;\nreturn [{json:{apply,mode,syntax,id:row.id,bakName:'_bak_'+id+'_'+page,before:row.content.length,after:JSON.stringify(o).length,scriptLen:js.length,bak:apply?row.content:'',content:apply?JSON.stringify(o):''}}];"
      }
    },
