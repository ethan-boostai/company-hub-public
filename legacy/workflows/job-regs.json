      {
        "id": "0ac02100-2836-4960-a62d-bd9b8d8673a9",
        "name": "Combine",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          3960,
          0
        ],
        "parameters": {
          "jsCode": "/* Same shape as cbs-admin-data for these registers, so the Job File reads it unchanged. Per-job registers were read with a loose\n   'contains the job number' filter; the Job File matches the job exactly itself. Sign-on signature images are left out. */\nconst K = ['rams','cphsp','prestarts','toolbox','signons','incidents','subjobs','pos','ptmsheets','scaffinsp','subbies','subdocs','assets','materials','suppliers','workers','stockmoves'];\nconst out = {};\nK.forEach(k => { let a = []; try { a = $('Get ' + k).all().map(i => i.json).filter(r => r && r.id); } catch (e) {} out[k] = a; });\nout.signons = out.signons.map(r => { const o = Object.assign({}, r); o.has_signature = r.signature ? 'Yes' : 'No'; delete o.signature; return o; });\nout.hsmeet = out.toolbox;\nreturn [{ json: out }];\n",
          "mode": "runOnceForAllItems"
        }
      },
      {
        "id": "36b8d9bb-57f5-41a4-bdc9-21a95df1acf6",
        "name": "Respond",
